APP_NAME=YelpMe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=YelpMe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@yelpme.local"
MAIL_FROM_NAME="YelpMe"
# Desarrollo: MAIL_MAILER=log deja los correos (códigos de recuperación) en storage/logs/laravel.log.
# Producción (plan 013): Railway bloquea SMTP en Trial/Hobby → Brevo por su API HTTPS.
# MAIL_MAILER=brevo
# BREVO_API_KEY=            (Brevo → SMTP & API → API Keys; nunca subirla)
# MAIL_FROM_ADDRESS=        (remitente verificado en Brevo)
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Notificaciones push con Firebase (plan 012). Sin credenciales la API funciona igual, sin push.
# Local: JSON de la cuenta de servicio (Firebase → Configuración → Cuentas de servicio). No se sube a git.
FIREBASE_CREDENTIALS=storage/app/firebase/credenciales.json
# Producción (plan 013): el mismo JSON en base64; tiene prioridad sobre FIREBASE_CREDENTIALS.
FIREBASE_CREDENTIALS_BASE64=

# ---------- Producción en Railway (plan 013). Valores en el panel de Railway, nunca aquí. ----------
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=                    (php artisan key:generate --show)
# APP_URL=https://<api>.up.railway.app
# FRONTEND_URL=https://<panel>.vercel.app      (uno o varios, separados por coma)
# DB_HOST=${{MySQL.MYSQLHOST}}   DB_PORT=${{MySQL.MYSQLPORT}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}   DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}   DB_DATABASE=YelpMe
# LOG_CHANNEL=stderr
# RAILPACK_SKIP_MIGRATIONS=true  (el esquema vive en database/script-bd.sql, sin migraciones)
# ADMIN_PASSWORD=             (reemplaza Admin123* de los admins al correr db:seed)
# DEMO_PASSWORD=              (reemplaza Usuario123* de los usuarios de demo)
# MAIL_MAILER=brevo  BREVO_API_KEY=  MAIL_FROM_ADDRESS=
# FIREBASE_CREDENTIALS_BASE64=
ADMIN_PASSWORD=
DEMO_PASSWORD=
