<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido de Perfil (diseño: foto y nombre, datos y domicilio con mapa).
     Sin el CRUD de varias direcciones (un domicilio, plan 009). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.perfil.PerfilActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_4">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivFotoPerfil"
                    android:layout_width="@dimen/avatar"
                    android:layout_height="@dimen/avatar"
                    android:background="@color/ym_marca_suave"
                    android:contentDescription="@string/cd_foto_perfil"
                    android:padding="@dimen/espacio_3"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/tvPerfilNombreCorto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_4"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo"
                    tools:text="Nombre" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_nombre"
                    android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                <TextView
                    android:id="@+id/tvPerfilNombreCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/comun_sin_dato"
                    android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:text="@string/perfil_telefono"
                    android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                <TextView
                    android:id="@+id/tvPerfilTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/comun_sin_dato"
                    android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:text="@string/perfil_correo"
                    android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                <TextView
                    android:id="@+id/tvPerfilCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/comun_sin_dato"
                    android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:text="@string/perfil_domicilio"
                    android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                <TextView
                    android:id="@+id/tvPerfilDomicilio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_sin_domicilio"
                    android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />

                <FrameLayout
                    android:id="@+id/mapPerfilPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mapa_alto"
                    android:layout_marginTop="@dimen/espacio_2"
                    android:background="@color/ym_skeleton" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
