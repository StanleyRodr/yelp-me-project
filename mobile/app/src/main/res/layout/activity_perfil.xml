<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PerfilActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FDA836">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_header"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="¡Hola!"
                android:textColor="#1E1E2C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMenuHamburguesa"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/men_"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomMenuLayout"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_bottom_bar"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/policia" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/cruzroja" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/transito" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/proteccioncivil" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bomberos" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/contactos" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bottomMenuLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- VISTA A: PERFIL + DIRECCIONES -->
                <LinearLayout
                    android:id="@+id/layoutVistaPrincipalPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#FFF5E6"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="82dp"
                                    android:layout_height="82dp"
                                    app:cardCornerRadius="41dp"
                                    app:cardElevation="2dp">

                                    <ImageView
                                        android:id="@+id/ivFotoPerfil"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/dise_o_sin_t_tulo__19_" />
                                </androidx.cardview.widget.CardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvPerfilNombreCorto"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Nombre"
                                        android:textColor="#1E1E2C"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvPerfilFolio"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="#0000325"
                                        android:textColor="#4A4A4A"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="14dp"
                                android:background="#4A4A4A" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginEnd="10dp"
                                    android:src="@android:drawable/ic_menu_myplaces"
                                    app:tint="#1E1E2C" />

                                <TextView
                                    android:id="@+id/tvPerfilNombreCompleto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Nombre Apellido"
                                    android:textColor="#1E1E2C"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginEnd="10dp"
                                    android:src="@android:drawable/ic_menu_call"
                                    app:tint="#1E1E2C" />

                                <TextView
                                    android:id="@+id/tvPerfilTelefono"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2351000000"
                                    android:textColor="#1E1E2C"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginEnd="10dp"
                                    android:src="@android:drawable/ic_dialog_email"
                                    app:tint="#1E1E2C" />

                                <TextView
                                    android:id="@+id/tvPerfilCorreo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="correo@ejemplo.com"
                                    android:textColor="#1E1E2C"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:gravity="top"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginTop="2dp"
                                    android:layout_marginEnd="10dp"
                                    android:src="@android:drawable/ic_dialog_map"
                                    app:tint="#1E1E2C" />

                                <TextView
                                    android:id="@+id/tvPerfilDireccionPrincipal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Calle 1, Centro"
                                    android:textColor="#1E1E2C"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <FrameLayout
                                android:id="@+id/mapPerfilPrincipal"
                                android:layout_width="match_parent"
                                android:layout_height="170dp"
                                android:background="#D5E8D4">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="Mapa de ubicación actual"
                                    android:textColor="#4E6137" />
                            </FrameLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#FFF5E6"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="Direcciones"
                                android:textColor="#1E1E2C"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="14dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/btnAgregarDireccion"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_marginEnd="10dp"
                                    android:backgroundTint="#F7D05C"
                                    android:src="@android:drawable/ic_input_add"
                                    app:tint="#FFFFFF" />

                                <EditText
                                    android:id="@+id/etBuscarDireccion"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/input_bg"
                                    android:drawableEnd="@android:drawable/ic_menu_search"
                                    android:hint="Buscar..."
                                    android:paddingHorizontal="12dp"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llContenedorDirecciones"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:orientation="vertical" />

                            <Button
                                android:id="@+id/btnCambiarDireccionPredeterminada"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:backgroundTint="#F7D05C"
                                android:text="Cambiar dirección predeterminada"
                                android:textAllCaps="false"
                                android:textColor="#1E1E2C"
                                android:textSize="14sp"
                                app:cornerRadius="8dp" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- VISTA B: FORMULARIO AGREGAR / ACTUALIZAR DIRECCIÓN -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardFormularioDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFF5E6"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvTituloFormDireccion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:text="Actualizar Dirección"
                            android:textColor="#1E1E2C"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etDirEtiqueta"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/input_bg"
                            android:hint="Nombre (Ej. Casa, Escuela)"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etDirCalle"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/input_bg"
                            android:hint="Calle"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etDirColonia"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/input_bg"
                            android:hint="Colonia"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etDirNumero"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/input_bg"
                                android:hint="N#"
                                android:paddingHorizontal="12dp"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/etDirCP"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/input_bg"
                                android:hint="C.P"
                                android:inputType="number"
                                android:paddingHorizontal="12dp"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etDirUbicacion"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/input_bg"
                            android:hint="Ubicación / Referencia"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:id="@+id/mapPerfilForm"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginBottom="16dp"
                            android:background="#E0E0E0">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Seleccionar punto en mapa"
                                android:textColor="#616161" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnGuardarDireccion"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="10dp"
                                android:layout_weight="1"
                                android:backgroundTint="#8BC34A"
                                android:text="Actualizar"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                app:cornerRadius="8dp" />

                            <Button
                                android:id="@+id/btnCancelarDireccion"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F44336"
                                android:text="Cancelar"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </FrameLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>