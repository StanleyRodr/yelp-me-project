<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido de Perfil (diseño: foto y nombre, datos y domicilio con mapa).
     Un domicilio por usuario (plan 009); tarjeta "Mi cuenta" con strikes. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recargaPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.perfil.PerfilActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_4">

            <!-- Foto y nombre -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/avatar_perfil"
                        android:layout_height="@dimen/avatar_perfil">

                        <TextView
                            android:id="@+id/tvAvatarInicial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.YelpMe.Titulo"
                            android:textColor="@color/ym_marca_texto"
                            tools:text="CR" />

                        <ImageView
                            android:id="@+id/ivFotoPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/cd_foto_perfil"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espacio_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPerfilNombreCorto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo"
                            tools:text="Carlos" />

                        <TextView
                            android:id="@+id/tvPerfilFolio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                            tools:text="Cuenta #2" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Datos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaDatos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_nombre"
                        android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                    <TextView
                        android:id="@+id/tvPerfilNombreCompleto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/comun_sin_dato"
                        android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_3"
                        android:text="@string/perfil_telefono"
                        android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                    <TextView
                        android:id="@+id/tvPerfilTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/comun_sin_dato"
                        android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_3"
                        android:text="@string/perfil_correo"
                        android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                    <TextView
                        android:id="@+id/tvPerfilCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/comun_sin_dato"
                        android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mi cuenta: strikes y suspensiones -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/perfil_mi_cuenta"
                        android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo" />

                    <TextView
                        android:id="@+id/tvAvisoSuspendido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_3"
                        android:background="@drawable/bg_aviso_peligro"
                        android:padding="@dimen/espacio_3"
                        android:text="@string/perfil_suspendido"
                        android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo"
                        android:textColor="@color/ym_estado_pendiente_texto"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPerfilStrikes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_3"
                        android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo"
                        tools:text="1 de 3 strikes" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progresoStrikes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_2"
                        app:indicatorColor="@color/ym_estado_pendiente"
                        app:trackColor="@color/ym_skeleton"
                        app:trackCornerRadius="@dimen/radio"
                        app:trackStopIndicatorSize="0dp"
                        app:trackThickness="8dp" />

                    <TextView
                        android:id="@+id/tvPerfilSuspensiones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_2"
                        android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                        tools:text="Suspendido 2 veces" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Domicilio -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/perfil_domicilio"
                        android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo" />

                    <TextView
                        android:id="@+id/tvPerfilDomicilio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_2"
                        android:text="@string/perfil_sin_domicilio"
                        android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />

                    <TextView
                        android:id="@+id/tvPerfilReferencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                        android:visibility="gone"
                        tools:text="Referencia: portón café" />

                    <FrameLayout
                        android:id="@+id/mapPerfilPrincipal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/mapa_alto"
                        android:layout_marginTop="@dimen/espacio_3"
                        android:background="@color/ym_skeleton"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
