<?xml version="1.0" encoding="utf-8"?>
<!-- Quién me tiene como contacto (VinculosActivity, contenido de BaseActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.vinculos.VinculosActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/espacio_4"
        android:layout_marginTop="@dimen/espacio_4"
        android:accessibilityHeading="true"
        android:text="@string/vinculos_titulo"
        android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/espacio_4"
        android:layout_marginTop="@dimen/espacio_1"
        android:text="@string/vinculos_explicacion"
        android:textAppearance="@style/TextAppearance.YelpMe.Pequeno" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/espacio_2"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/recargaVinculos"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVinculos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/espacio_4"
                android:paddingBottom="@dimen/espacio_4"
                tools:listitem="@layout/item_vinculo" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/espacio_5"
            android:layout_marginTop="@dimen/espacio_6"
            android:gravity="center"
            android:text="@string/vinculos_vacio"
            android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo"
            android:textColor="@color/ym_texto_secundario"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btnBloqueados"
        style="@style/Widget.YelpMe.Boton.Texto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/espacio_4"
        android:text="@string/vinculos_ver_bloqueados"
        app:icon="@drawable/ic_block"
        app:iconGravity="textStart" />
</LinearLayout>
