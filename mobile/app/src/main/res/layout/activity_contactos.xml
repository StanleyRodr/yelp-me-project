<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutContactos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.contactos.ContactosActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FDA836">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_header"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="¡Hola!"
                android:textColor="#1E1E2C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMenuHamburguesa"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/men_"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomMenuLayout"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_bottom_bar"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/policia" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/cruzroja" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/transito" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/proteccioncivil" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bomberos" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/contactos" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bottomMenuLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- VISTA A: LISTA DE CONTACTOS -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardListaContactos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:cardBackgroundColor="#FFF5E6"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Contactos de urgencia"
                            android:textColor="#1E1E2C"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnAgregarContacto"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="10dp"
                                android:backgroundTint="#F7D05C"
                                android:src="@android:drawable/ic_input_add"
                                app:tint="#FFFFFF" />

                            <EditText
                                android:id="@+id/etBuscarContacto"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@drawable/input_bg"
                                android:drawableEnd="@android:drawable/ic_menu_search"
                                android:hint="Buscar..."
                                android:paddingHorizontal="12dp"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llContenedorListaContactos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Contacto de emergencia"
                            android:textColor="#1E1E2C"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvContactoEmergenciaActual"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/bg_item_contacto"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="Contacto de emergencia"
                            android:textColor="#2A2A2A"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnCambiarEmergencia"
                            android:layout_width="140dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center_horizontal"
                            android:backgroundTint="#F7D05C"
                            android:text="Cambiar"
                            android:textAllCaps="false"
                            android:textColor="#1E1E2C"
                            app:cornerRadius="8dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- VISTA B: DETALLE DE CONTACTO -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDetalleContacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFF5E6"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/btnVolverDeDetalle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="← Volver"
                            android:textColor="#616161"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAvatarInicial"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_circulo_avatar"
                            android:gravity="center"
                            android:text="C"
                            android:textColor="#1E1E2C"
                            android:textSize="40sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetalleApodo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Apodo"
                            android:textColor="#1E1E2C"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="14dp"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnLlamarContacto"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="20dp"
                                android:background="@drawable/bg_circulo_avatar"
                                android:backgroundTint="#00C853"
                                android:src="@android:drawable/ic_menu_call"
                                app:tint="#FFFFFF" />

                            <ImageButton
                                android:id="@+id/btnEliminarContacto"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_circulo_avatar"
                                android:backgroundTint="#F44336"
                                android:src="@android:drawable/ic_menu_delete"
                                app:tint="#FFFFFF" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDetalleNombreUsuario"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_subcard_amarilla"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="Nombre de usuario"
                            android:textColor="#1E1E2C" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvDetalleId"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_subcard_amarilla"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:text="ID"
                                android:textColor="#1E1E2C" />

                            <TextView
                                android:id="@+id/tvDetalleTelefono"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1.3"
                                android:background="@drawable/bg_subcard_amarilla"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:text="# de teléfono"
                                android:textColor="#1E1E2C" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_subcard_amarilla"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvDetalleDireccionContacto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Dirección"
                                android:textColor="#1E1E2C" />

                            <FrameLayout
                                android:id="@+id/mapContactoDetalle"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:background="#D5E8D4">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="Mapa del contacto"
                                    android:textColor="#4E6137" />
                            </FrameLayout>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- VISTA C: FORMULARIO NUEVO CONTACTO -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardNuevoContacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFF5E6"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:text="Nuevo contacto"
                            android:textColor="#1E1E2C"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etNuevoApodo"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/input_bg"
                            android:hint="Apodo"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etNuevoNombreUsuario"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/input_bg"
                            android:hint="Nombre de usuario"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/etNuevoId"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/input_bg"
                                android:hint="ID"
                                android:paddingHorizontal="12dp"
                                android:textSize="14sp" />

                            <EditText
                                android:id="@+id/etNuevoTelefono"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1.3"
                                android:background="@drawable/input_bg"
                                android:hint="# de teléfono"
                                android:inputType="phone"
                                android:paddingHorizontal="12dp"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etNuevaDireccion"
                            android:layout_width="match_parent"
                            android:layout_height="75dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/input_bg"
                            android:gravity="top|start"
                            android:hint="Dirección"
                            android:padding="12dp"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:id="@+id/mapContactoNuevo"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginBottom="16dp"
                            android:background="#E0E0E0">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Seleccionar ubicación en mapa"
                                android:textColor="#616161" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnGuardarNuevoContacto"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="10dp"
                                android:layout_weight="1"
                                android:backgroundTint="#8BC34A"
                                android:text="Guardar"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                app:cornerRadius="8dp" />

                            <Button
                                android:id="@+id/btnCancelarNuevoContacto"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F44336"
                                android:text="Cancelar"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </FrameLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>