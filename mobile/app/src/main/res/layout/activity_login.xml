<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDA836"
    tools:context=".ui.login.LoginActivity">

    <!-- Logo de la app -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="150dp"
        android:layout_height="138dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.275"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.126"
        app:srcCompat="@drawable/dise_o_sin_t_tulo__18_" />

    <!-- Título de la app -->
    <TextView
        android:id="@+id/nombreapp"
        android:layout_width="120dp"
        android:layout_height="137dp"
        android:fontFamily="@font/lilita_one"
        android:text="YelpME"
        android:textColor="#FFFFFF"
        android:textSize="60sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.762"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.126" />

    <!-- Tarjeta del formulario de inicio de sesión -->
    <androidx.cardview.widget.CardView
        android:id="@+id/formularioiniciosesion"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFF5E6"
        app:cardCornerRadius="25dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintVertical_bias="0.3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Encabezado: Ícono y texto Iniciar sesión -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iniciosesionfoto"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/dise_o_sin_t_tulo__19_" />

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/raleway_light"
                    android:text="Iniciar sesión"
                    android:textAlignment="center"
                    android:textColor="#2A2A2A"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Campo E-mail -->
            <EditText
                android:id="@+id/editTextTextEmailAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/input_bg"
                android:ems="10"
                android:hint="E-mail"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#2A2A2A"
                android:textColorHint="#757575"
                android:textSize="15sp" />

            <!-- Campo Contraseña -->
            <EditText
                android:id="@+id/editTextTextPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_bg"
                android:ems="10"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#2A2A2A"
                android:textColorHint="#757575"
                android:textSize="15sp" />

            <!-- Botón Iniciar sesión -->
            <Button
                android:id="@+id/btnIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#F7D05C"
                android:fontFamily="@font/raleway_light"
                android:text="Iniciar sesión"
                android:textAllCaps="false"
                android:textColor="#2A2A2A"
                android:textSize="16sp"
                app:cornerRadius="8dp" />

            <!-- Botón Regístrate -->
            <Button
                android:id="@+id/btnRegistrate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#F7D05C"
                android:fontFamily="@font/raleway_light"
                android:text="Registrate"
                android:textAllCaps="false"
                android:textColor="#2A2A2A"
                android:textSize="16sp"
                app:cornerRadius="8dp" />

            <!-- Enlace ¿Olvidaste tu contraseña? -->
            <TextView
                android:id="@+id/tvOlvidasteContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/raleway_light"
                android:gravity="center"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#1A237E"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>