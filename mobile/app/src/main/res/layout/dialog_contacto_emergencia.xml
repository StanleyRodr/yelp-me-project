<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#E2F9C6"
    app:cardCornerRadius="25dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Contacto de\nemergencia"
                android:textColor="#1E1E2C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCerrarModalEmergencia"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_delete"
                app:tint="#E53935" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Selecciona tu nuevo contacto de emergencia"
            android:textColor="#2A2A2A"
            android:textSize="13sp" />

        <!-- Lista de opciones seleccionables -->
        <ListView
            android:id="@+id/lvContactosModal"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#B2EB75"
            android:choiceMode="singleChoice"
            android:divider="#8BC34A"
            android:dividerHeight="1dp"
            android:listSelector="#7CB342" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:text="*Tu contacto de emergencia es tu número predeterminado a quien le llegarán tus solicitudes/llamadas de ayuda"
            android:textColor="#333333"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnConfirmarEmergencia"
            android:layout_width="160dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="#8BC34A"
            android:text="Confirmar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>