<?xml version="1.0" encoding="utf-8"?>
<!-- Domicilio único con su punto en el mapa (DomicilioActivity). Campos del formulario de dirección del diseño original, sin "etiqueta". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.perfil.DomicilioActivity">

    <include
        android:id="@+id/barra"
        layout="@layout/layout_barra_secundaria" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/desplazable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_4">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/domicilio_calle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="postalAddress"
                    android:inputType="textPostalAddress|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNumero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_3"
                android:hint="@string/domicilio_numero">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNumero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="postalAddress"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilColonia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_3"
                android:hint="@string/domicilio_colonia">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etColonia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCodigoPostal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_3"
                android:hint="@string/domicilio_cp"
                app:counterEnabled="true"
                app:counterMaxLength="5">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCodigoPostal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="postalCode"
                    android:inputType="number"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReferencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_3"
                android:hint="@string/domicilio_referencia"
                app:helperText="@string/domicilio_referencia_ayuda">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReferencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="255" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_4"
                android:text="@string/domicilio_punto"
                android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

            <TextView
                android:id="@+id/tvErrorPunto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_1"
                android:text="@string/domicilio_falta_punto"
                android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                android:textColor="@color/ym_estado_pendiente_texto"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/contenedorMapa"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mapa_alto"
                android:layout_marginTop="@dimen/espacio_2"
                android:background="@color/ym_skeleton"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnMarcar"
                style="@style/Widget.YelpMe.Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_2"
                android:text="@string/domicilio_marcar"
                app:icon="@drawable/ic_place"
                app:iconGravity="textStart"
                app:iconTint="@color/ym_texto" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_5"
                android:text="@string/domicilio_guardar" />

            <Button
                android:id="@+id/btnQuitar"
                style="@style/Widget.YelpMe.Boton.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_2"
                android:text="@string/domicilio_quitar"
                android:textColor="@color/ym_estado_pendiente_texto"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
