<?xml version="1.0" encoding="utf-8"?>
<!-- Motivo obligatorio al cancelar una solicitud. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/espacio_5"
    android:paddingTop="@dimen/espacio_2">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilMotivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/solicitud_motivo">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
