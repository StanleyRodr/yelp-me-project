<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la lista de contactos (AdaptadorContactos). Toda la fila abre el detalle. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espacio_2"
    android:clickable="true"
    android:focusable="true"
    app:contentPadding="@dimen/espacio_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvInicial"
            android:layout_width="@dimen/toque_min"
            android:layout_height="@dimen/toque_min"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo"
            android:textColor="@color/ym_marca_texto"
            tools:text="M" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo"
                android:textStyle="bold"
                tools:text="María López" />

            <TextView
                android:id="@+id/tvDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                tools:text="Pareja, 2351000002" />

            <TextView
                android:id="@+id/tvVinculado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_1"
                android:background="@drawable/bg_etiqueta"
                android:drawablePadding="@dimen/espacio_1"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/espacio_2"
                android:paddingVertical="2dp"
                android:text="@string/contactos_vinculado"
                android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                android:textColor="@color/ym_marca_texto"
                app:drawableStartCompat="@drawable/ic_link"
                app:drawableTint="@color/ym_marca_texto" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivFavorito"
            android:layout_width="@dimen/icono"
            android:layout_height="@dimen/icono"
            android:layout_marginStart="@dimen/espacio_2"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_star"
            app:tint="@color/ym_estado_enviado" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
