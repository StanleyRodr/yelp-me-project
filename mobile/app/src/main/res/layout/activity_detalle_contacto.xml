<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle de un contacto (DetalleContactoActivity), con el estilo de la tarjeta
     de detalle del diseño: inicial, nombre, teléfono y parentesco. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.contactos.DetalleContactoActivity">

    <include
        android:id="@+id/barra"
        layout="@layout/layout_barra_secundaria" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/desplazable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_4">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvInicial"
                            android:layout_width="@dimen/avatar"
                            android:layout_height="@dimen/avatar"
                            android:background="@drawable/bg_avatar"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.YelpMe.Titulo"
                            android:textColor="@color/ym_marca_texto"
                            tools:text="M" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_4"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityHeading="true"
                                android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo"
                                tools:text="María López" />

                            <TextView
                                android:id="@+id/tvVinculo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/espacio_1"
                                android:background="@drawable/bg_etiqueta"
                                android:drawablePadding="@dimen/espacio_1"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="@dimen/espacio_2"
                                android:paddingVertical="2dp"
                                android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                                android:textColor="@color/ym_marca_texto"
                                app:drawableTint="@color/ym_marca_texto"
                                tools:text="Vinculado" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_4"
                        android:text="@string/contactos_telefono"
                        android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                    <TextView
                        android:id="@+id/tvTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo"
                        tools:text="2351000002" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_3"
                        android:text="@string/contactos_parentesco"
                        android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                    <TextView
                        android:id="@+id/tvParentesco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo"
                        tools:text="Pareja" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnLlamar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_4"
                android:text="@string/contactos_llamar"
                app:icon="@drawable/ic_call"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorito"
                style="@style/Widget.YelpMe.Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_2"
                android:text="@string/contactos_marcar_favorito"
                app:icon="@drawable/ic_star_border"
                app:iconGravity="textStart"
                app:iconTint="@color/ym_estado_enviado" />

            <Button
                android:id="@+id/btnEditar"
                style="@style/Widget.YelpMe.Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_2"
                android:text="@string/contactos_editar"
                app:icon="@drawable/ic_edit"
                app:iconGravity="textStart"
                app:iconTint="@color/ym_texto" />

            <Button
                android:id="@+id/btnEliminar"
                style="@style/Widget.YelpMe.Boton.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_2"
                android:text="@string/contactos_eliminar"
                android:textColor="@color/ym_estado_pendiente_texto"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconTint="@color/ym_estado_pendiente_texto" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
