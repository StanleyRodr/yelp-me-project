<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño original: tarjeta "Recuperar contraseña" con correo, código y contraseña nueva.
     Cada paso es un contenedor; solo uno visible a la vez. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.recuperar.RecuperarContrasenaActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/desplazable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/encabezado"
                layout="@layout/layout_encabezado_acceso" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/espacio_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icono_servicio"
                            android:layout_height="@dimen/icono_servicio"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lock_reset" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_3"
                            android:accessibilityHeading="true"
                            android:text="@string/recuperar_titulo"
                            android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo" />
                    </LinearLayout>

                    <!-- Paso 1: correo -->
                    <LinearLayout
                        android:id="@+id/pasoCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_3"
                            android:text="@string/recuperar_paso_correo"
                            android:textAppearance="@style/TextAppearance.YelpMe.Pequeno" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_4"
                            android:hint="@string/recuperar_correo">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCorreo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="emailAddress"
                                android:imeOptions="actionDone"
                                android:inputType="textEmailAddress" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnEnviarCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_4"
                            android:text="@string/recuperar_enviar" />
                    </LinearLayout>

                    <!-- Paso 2: código -->
                    <LinearLayout
                        android:id="@+id/pasoCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvDescripcionCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_3"
                            android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                            tools:text="@string/recuperar_paso_codigo" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_4"
                            android:hint="@string/recuperar_codigo"
                            app:counterEnabled="true"
                            app:counterMaxLength="6">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCodigo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="6" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnVerificar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_4"
                            android:text="@string/recuperar_verificar" />

                        <Button
                            android:id="@+id/btnReenviar"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_2"
                            android:text="@string/recuperar_reenviar" />
                    </LinearLayout>

                    <!-- Paso 3: contraseña nueva -->
                    <LinearLayout
                        android:id="@+id/pasoPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_3"
                            android:text="@string/recuperar_paso_password"
                            android:textAppearance="@style/TextAppearance.YelpMe.Pequeno" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNueva"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_4"
                            android:hint="@string/recuperar_nueva"
                            app:endIconMode="password_toggle"
                            app:helperText="@string/registro_password_ayuda">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNueva"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="newPassword"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilConfirmar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_3"
                            android:hint="@string/recuperar_confirmar"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etConfirmar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="newPassword"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnGuardar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_4"
                            android:text="@string/recuperar_guardar" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
