<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido de Historial (diseño: lista con filtro). El filtro es un grupo de chips
     (en lugar del Spinner) y el detalle es DetalleSolicitudActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.historial.HistorialActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/espacio_4"
        android:layout_marginTop="@dimen/espacio_4"
        android:accessibilityHeading="true"
        android:text="@string/historial_titulo"
        android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_2"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/espacio_4"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgFiltro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/historial_filtro"
            app:checkedChip="@id/chipTodas"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodas"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historial_todas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPendiente"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_pendiente" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnviado"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_enviado" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTerminado"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_terminado" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCancelado"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_cancelado" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRechazado"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estado_rechazado" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/recargaHistorial"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/espacio_4"
                android:paddingBottom="@dimen/espacio_4"
                tools:listitem="@layout/item_solicitud" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/espacio_5"
            android:layout_marginTop="@dimen/espacio_6"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo"
            android:textColor="@color/ym_texto_secundario"
            android:visibility="gone"
            tools:text="@string/historial_vacio" />
    </FrameLayout>
</LinearLayout>
