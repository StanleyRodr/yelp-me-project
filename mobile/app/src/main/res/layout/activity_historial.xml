<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido de Historial (diseño: lista con filtro y detalle). Se conecta en el plan 011. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.historial.HistorialActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_4">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardListaHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/historial_titulo"
                    android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFiltro"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:hint="@string/historial_filtro">

                    <AutoCompleteTextView
                        android:id="@+id/etFiltro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:text="@string/historial_vacio"
                    android:textAppearance="@style/TextAppearance.YelpMe.Pequeno" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDetalleHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnVolverHistorial"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/historial_volver"
                    app:icon="@drawable/ic_arrow_back" />

                <TextView
                    android:id="@+id/tvTituloSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_2"
                    android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo" />

                <TextView
                    android:id="@+id/tvEstadoSolicitud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_2"
                    android:paddingHorizontal="@dimen/espacio_3"
                    android:paddingVertical="@dimen/espacio_1"
                    android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:text="@string/historial_emergencia"
                    android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                <TextView
                    android:id="@+id/tvHistEmergencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:text="@string/historial_ayudas"
                    android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                <LinearLayout
                    android:id="@+id/llHistAyudas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:text="@string/historial_lugar"
                    android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                <TextView
                    android:id="@+id/tvHistLugar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />

                <FrameLayout
                    android:id="@+id/mapHistorialDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mapa_alto"
                    android:layout_marginTop="@dimen/espacio_2"
                    android:background="@color/ym_skeleton" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:text="@string/historial_comentarios"
                    android:textAppearance="@style/TextAppearance.YelpMe.Etiqueta" />

                <TextView
                    android:id="@+id/tvHistComentarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
