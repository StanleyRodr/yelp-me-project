<?xml version="1.0" encoding="utf-8"?>
<!-- Editar una solicitud Pendiente (FormSolicitudActivity): mismos campos que Inicio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.solicitudes.FormSolicitudActivity">

    <include
        android:id="@+id/barra"
        layout="@layout/layout_barra_secundaria" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/desplazable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_4">

            <include
                android:id="@+id/formulario"
                layout="@layout/layout_form_solicitud" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_5"
                android:text="@string/perfil_guardar_cambios" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
