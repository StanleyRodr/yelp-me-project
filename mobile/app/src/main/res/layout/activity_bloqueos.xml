<?xml version="1.0" encoding="utf-8"?>
<!-- Personas bloqueadas (BloqueosActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.vinculos.BloqueosActivity">

    <include
        android:id="@+id/barra"
        layout="@layout/layout_barra_secundaria" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/espacio_4"
        android:layout_marginTop="@dimen/espacio_4"
        android:text="@string/bloqueos_aviso"
        android:textAppearance="@style/TextAppearance.YelpMe.Pequeno" />

    <FrameLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBloqueos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/espacio_4"
            android:paddingBottom="@dimen/espacio_4"
            tools:listitem="@layout/item_bloqueo" />

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/espacio_5"
            android:layout_marginTop="@dimen/espacio_6"
            android:gravity="center"
            android:text="@string/bloqueos_vacio"
            android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo"
            android:textColor="@color/ym_texto_secundario"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
