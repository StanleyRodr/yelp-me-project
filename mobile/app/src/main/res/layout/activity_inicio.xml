<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido de Inicio (diseño "Solicitudes"): tarjeta "Tu solicitud" (la activa)
     y formulario para pedir ayuda. Header, menú y barra los pone BaseActivity. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.inicio.InicioActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_4">

        <!-- Tu solicitud activa (Pendiente o Enviado): toda la tarjeta abre el detalle -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTuSolicitud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/espacio_4"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/inicio_tu_solicitud"
                        android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo" />

                    <TextView
                        android:id="@+id/tvBadgeActiva"
                        style="@style/YelpMe.Badge"
                        tools:text="Pendiente" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActivaTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_3"
                    android:textAppearance="@style/TextAppearance.YelpMe.Cuerpo"
                    android:textStyle="bold"
                    tools:text="Choque en la avenida" />

                <TextView
                    android:id="@+id/tvActivaMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_1"
                    android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                    android:textColor="@color/ym_texto"
                    tools:text="Esperando a que un administrador la atienda." />

                <LinearLayout
                    android:id="@+id/llActivaServicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_2"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/tvActivaHace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_2"
                    android:drawablePadding="@dimen/espacio_1"
                    android:textAppearance="@style/TextAppearance.YelpMe.Pequeno"
                    app:drawableEndCompat="@drawable/ic_arrow_forward"
                    app:drawableTint="@color/ym_texto_secundario"
                    tools:text="Hace 5 min. Ver detalle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Formulario: pedir ayuda (título, ubicación, servicios, comentarios) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/inicio_titulo"
                    android:textAppearance="@style/TextAppearance.YelpMe.Subtitulo" />

                <include
                    android:id="@+id/formulario"
                    layout="@layout/layout_form_solicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_4"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLimpiar"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espacio_2"
                        android:layout_weight="1"
                        android:text="@string/inicio_limpiar" />

                    <Button
                        android:id="@+id/btnEnviarSolicitud"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/inicio_enviar" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
