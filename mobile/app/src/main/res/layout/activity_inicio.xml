<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutSolicitudes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.inicio.InicioActivity">

    <!-- CONTENIDO PRINCIPAL DE LA PANTALLA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FDA836">

        <!-- 1. HEADER SUPERIOR FIJO -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_header"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvSaludoUsuario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="¡Hola!"
                android:textColor="#1E1E2C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMenuHamburguesa"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/men_" />
        </LinearLayout>

        <!-- 2. MENÚ INFERIOR FIJO (6 ICONOS DE EMERGENCIA) -->
        <LinearLayout
            android:id="@+id/bottomMenuLayout"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_bottom_bar"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/navPolicia"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/policia" />

            <ImageButton
                android:id="@+id/navCruzRoja"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/cruzroja" />

            <ImageButton
                android:id="@+id/navBomberos"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/transito" />

            <ImageButton
                android:id="@+id/navProteccionCivil"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/proteccioncivil" />

            <ImageButton
                android:id="@+id/navTransito"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bomberos" />

            <ImageButton
                android:id="@+id/navContactoEmergencia"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/contactos" />
        </LinearLayout>

        <!-- 3. CONTENIDO CENTRAL CON SCROLL -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/bottomMenuLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <!-- PRIMERA TARJETA: FORMULARIO DE SOLICITUD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFF5E6"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:text="Solicitudes"
                            android:textColor="#1E1E2C"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- Fila Emergencia -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="90dp"
                                android:layout_height="wrap_content"
                                android:text="Emergencia"
                                android:textColor="#2A2A2A"
                                android:textSize="15sp" />

                            <EditText
                                android:id="@+id/etEmergencia"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@drawable/input_bg"
                                android:inputType="text"
                                android:paddingHorizontal="10dp"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Fila Lugar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="90dp"
                                android:layout_height="wrap_content"
                                android:text="Lugar"
                                android:textColor="#2A2A2A"
                                android:textSize="15sp" />

                            <EditText
                                android:id="@+id/etLugar"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@drawable/input_bg"
                                android:inputType="textPostalAddress"
                                android:paddingHorizontal="10dp"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Contenedor para el Mapa -->
                        <FrameLayout
                            android:id="@+id/mapContainer"
                            android:layout_width="match_parent"
                            android:layout_height="190dp"
                            android:layout_marginBottom="14dp"
                            android:background="#E0E0E0">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Vista previa del Mapa"
                                android:textColor="#616161" />
                        </FrameLayout>

                        <!-- Sección Ayuda de: -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="Ayuda de:"
                            android:textColor="#2A2A2A"
                            android:textSize="15sp" />

                        <!-- Fila 1 de Iconos (Policía, Cruz Roja, Bomberos) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnSelectPolicia"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_marginEnd="14dp"
                                android:backgroundTint="#283a55"
                                android:scaleType="fitCenter"
                                android:src="@drawable/poli" />

                            <ImageButton
                                android:id="@+id/btnSelectCruzRoja"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_marginEnd="14dp"
                                android:backgroundTint="#FF0000"
                                android:scaleType="fitCenter"
                                android:src="@drawable/cr" />

                            <ImageButton
                                android:id="@+id/btnSelectBomberos"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:backgroundTint="#f6bc2d"
                                android:scaleType="fitCenter"
                                android:src="@drawable/transi" />
                        </LinearLayout>

                        <!-- Fila 2 de Iconos (Protección Civil, Tránsito, Contacto) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnSelectProteccion"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_marginEnd="14dp"
                                android:backgroundTint="#ff7f08"
                                android:scaleType="fitCenter"
                                android:src="@drawable/pc" />

                            <ImageButton
                                android:id="@+id/btnSelectTransito"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_marginEnd="14dp"
                                android:backgroundTint="#a6a6a6"
                                android:scaleType="fitCenter"
                                android:src="@drawable/bomb" />

                            <ImageButton
                                android:id="@+id/btnSelectContacto"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:backgroundTint="#00bf63"
                                android:scaleType="fitCenter"
                                android:src="@drawable/contac" />
                        </LinearLayout>

                        <!-- Fila Comentarios -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="95dp"
                                android:layout_height="wrap_content"
                                android:text="Comentarios"
                                android:textColor="#2A2A2A"
                                android:textSize="15sp" />

                            <EditText
                                android:id="@+id/etComentarios"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@drawable/input_bg"
                                android:inputType="textMultiLine"
                                android:paddingHorizontal="10dp"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Botones Limpiar y Enviar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnLimpiar"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="10dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F7D05C"
                                android:text="Limpiar"
                                android:textAllCaps="false"
                                android:textColor="#2A2A2A"
                                app:cornerRadius="8dp" />

                            <Button
                                android:id="@+id/btnEnviarSolicitud"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F7D05C"
                                android:text="Enviar"
                                android:textAllCaps="false"
                                android:textColor="#2A2A2A"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SEGUNDA TARJETA: TU SOLICITUD (Oculta inicialmente hasta confirmar modal) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTuSolicitud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFF5E6"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Tu solicitud"
                            android:textColor="#1E1E2C"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- Barra de Estado Dinámica (Rojo / Naranja / Verde) -->
                        <TextView
                            android:id="@+id/tvBannerEstado"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/input_bg"
                            android:backgroundTint="#FF0000"
                            android:gravity="center"
                            android:text="SIN ATENDER"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Fila superior: Emergencia y Ayudas -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <!-- Caja Emergencia -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_subcard_amarilla"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Emergencia"
                                    android:textColor="#1E1E2C"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDetalleEmergencia"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Descripción..."
                                    android:textColor="#2A2A2A"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Caja Ayudas -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1.1"
                                android:background="@drawable/bg_subcard_amarilla"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="6dp"
                                    android:text="Ayudas"
                                    android:textColor="#1E1E2C"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:id="@+id/llDetalleAyudas"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Caja Lugar + Mapa -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_subcard_amarilla"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lugar"
                                android:textColor="#1E1E2C"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetalleLugar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Ubicación..."
                                android:textColor="#2A2A2A"
                                android:textSize="13sp" />

                            <FrameLayout
                                android:id="@+id/mapDetalleContainer"
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:background="#D5E8D4">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="Mapa de seguimiento"
                                    android:textColor="#4E6137" />
                            </FrameLayout>
                        </LinearLayout>

                        <!-- Caja Comentarios -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_subcard_amarilla"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Comentarios"
                                android:textColor="#1E1E2C"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetalleComentarios"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Sin comentarios"
                                android:textColor="#2A2A2A"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Botones Editar y Cancelar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnEditarSolicitud"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="10dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F7D05C"
                                android:text="Editar"
                                android:textAllCaps="false"
                                android:textColor="#1E1E2C"
                                app:cornerRadius="8dp" />

                            <Button
                                android:id="@+id/btnCancelarSolicitud"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:backgroundTint="#F4511E"
                                android:text="Cancelar"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MENÚ LATERAL DESPLEGABLE (INCLUIDO DESDE menu_drawer.xml) -->
    <include layout="@layout/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>