<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema único: DayNight toma values-night/colors.xml en modo oscuro. -->
    <style name="Theme.YelpMe" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ym_marca_texto</item>
        <item name="colorOnPrimary">@color/ym_sobre_marca_texto</item>
        <item name="colorPrimaryContainer">@color/ym_marca_suave</item>
        <item name="colorOnPrimaryContainer">@color/ym_texto</item>
        <item name="colorSecondary">@color/ym_marca_texto</item>
        <item name="colorOnSecondary">@color/ym_sobre_marca_texto</item>
        <item name="colorSecondaryContainer">@color/ym_marca_suave</item>
        <item name="colorOnSecondaryContainer">@color/ym_texto</item>
        <item name="android:colorBackground">@color/ym_fondo</item>
        <item name="colorOnBackground">@color/ym_texto</item>
        <item name="colorSurface">@color/ym_superficie</item>
        <item name="colorOnSurface">@color/ym_texto</item>
        <item name="colorOnSurfaceVariant">@color/ym_texto_secundario</item>
        <item name="colorSurfaceContainerLowest">@color/ym_superficie</item>
        <item name="colorSurfaceContainerLow">@color/ym_superficie</item>
        <item name="colorSurfaceContainer">@color/ym_superficie</item>
        <item name="colorSurfaceContainerHigh">@color/ym_superficie</item>
        <item name="colorSurfaceContainerHighest">@color/ym_superficie</item>
        <item name="colorOutline">@color/ym_borde_fuerte</item>
        <item name="colorOutlineVariant">@color/ym_borde</item>
        <item name="colorError">@color/ym_peligro</item>
        <item name="colorOnError">@color/ym_sobre_marca</item>

        <item name="fontFamily">@font/atkinson</item>
        <item name="android:fontFamily">@font/atkinson</item>

        <!-- Header y barra inferior son color marca: íconos claros en las barras del sistema -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="materialButtonStyle">@style/Widget.YelpMe.Boton</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.YelpMe.Boton.Secundario</item>
        <item name="borderlessButtonStyle">@style/Widget.YelpMe.Boton.Texto</item>
        <item name="textInputStyle">@style/Widget.YelpMe.Campo</item>
        <item name="materialCardViewStyle">@style/Widget.YelpMe.Tarjeta</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.YelpMe.Dialogo</item>
        <!-- Sin tinte de elevación: superficies con el color exacto del token (como la web) -->
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- Diálogos: superficie y tipografía de la marca -->
    <style name="ThemeOverlay.YelpMe.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:fontFamily">@font/atkinson</item>
        <item name="fontFamily">@font/atkinson</item>
        <item name="materialAlertDialogTitleTextStyle">@style/YelpMe.Dialogo.Titulo</item>
        <item name="materialAlertDialogBodyTextStyle">@style/YelpMe.Dialogo.Cuerpo</item>
    </style>

    <style name="YelpMe.Dialogo.Titulo" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.YelpMe.Subtitulo</item>
        <item name="android:textColor">@color/ym_texto</item>
    </style>

    <style name="YelpMe.Dialogo.Cuerpo" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.YelpMe.Cuerpo</item>
        <item name="android:textColor">@color/ym_texto_secundario</item>
    </style>

    <!-- Splash (SplashActivity): logo sobre la marca mientras se confirma la sesión -->
    <style name="Theme.YelpMe.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ym_marca</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.YelpMe</item>
    </style>

    <!-- Botones: 48dp de alto mínimo y radio de 6dp como la web -->
    <style name="Widget.YelpMe.Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/toque_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.YelpMe.Boton</item>
        <item name="cornerRadius">@dimen/radio</item>
    </style>

    <style name="Widget.YelpMe.Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/toque_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.YelpMe.Boton</item>
        <item name="cornerRadius">@dimen/radio</item>
        <item name="strokeColor">@color/ym_borde_fuerte</item>
        <item name="android:textColor">@color/ym_texto</item>
    </style>

    <style name="Widget.YelpMe.Boton.Peligro" parent="Widget.YelpMe.Boton">
        <item name="backgroundTint">@color/ym_peligro</item>
        <item name="android:textColor">@color/ym_sobre_marca</item>
    </style>

    <style name="Widget.YelpMe.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/toque_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.YelpMe.Boton</item>
    </style>

    <!-- Botón de solo ícono sobre la barra de marca (menú, atrás) -->
    <style name="Widget.YelpMe.BotonIcono.Marca" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/toque_min</item>
        <item name="android:minHeight">@dimen/toque_min</item>
        <item name="iconSize">@dimen/icono</item>
        <item name="iconTint">@color/ym_sobre_marca</item>
    </style>

    <style name="Widget.YelpMe.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radio</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio</item>
        <item name="boxStrokeColor">@color/ym_marca_texto</item>
        <item name="errorTextColor">@color/ym_estado_pendiente_texto</item>
    </style>

    <style name="Widget.YelpMe.Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ym_superficie</item>
        <item name="cardCornerRadius">@dimen/radio</item>
        <item name="strokeColor">@color/ym_borde</item>
        <item name="contentPadding">@dimen/espacio_4</item>
    </style>

    <!-- Texto: 28 / 20 / 16 / 14 sp, pesos 700 / 400 como la web -->
    <style name="TextAppearance.YelpMe.Titulo" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ym_texto</item>
        <item name="fontFamily">@font/atkinson</item>
    </style>

    <style name="TextAppearance.YelpMe.Subtitulo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ym_texto</item>
        <item name="fontFamily">@font/atkinson</item>
    </style>

    <style name="TextAppearance.YelpMe.Cuerpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ym_texto</item>
        <item name="fontFamily">@font/atkinson</item>
    </style>

    <style name="TextAppearance.YelpMe.Pequeno" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ym_texto_secundario</item>
        <item name="fontFamily">@font/atkinson</item>
    </style>

    <style name="TextAppearance.YelpMe.Etiqueta" parent="TextAppearance.YelpMe.Pequeno">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.YelpMe.Boton" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/atkinson</item>
    </style>

    <!-- Texto sobre la barra de marca -->
    <style name="TextAppearance.YelpMe.Marca" parent="TextAppearance.YelpMe.Subtitulo">
        <item name="android:textColor">@color/ym_sobre_marca</item>
    </style>
</resources>
